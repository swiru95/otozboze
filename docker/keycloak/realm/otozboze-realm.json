{
  "realm": "otozboze",
  "displayName": "otozboze.pl (local dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "FARMER", "description": "May list grain offers" },
      { "name": "BUYER", "description": "May purchase grain offers" },
      { "name": "TRANSPORT", "description": "May accept freight jobs" },
      { "name": "ADMIN", "description": "Full platform access" }
    ]
  },
  "clients": [
    {
      "clientId": "otozboze-web",
      "name": "otozboze.pl web app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-otozboze-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:3000/*"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm roles as cognito:groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "cognito:groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
