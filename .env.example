# Copy to .env and adjust. Values below match docker-compose.yml as-is.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://otozboze:otozboze@localhost:5432/otozboze?schema=public"

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Trust the host header in local dev / behind a proxy.
AUTH_TRUST_HOST="true"

# --- Identity provider ------------------------------------------------------
# "keycloak" locally, "cognito" in production. Both emit a `cognito:groups`
# claim carrying the user's capability flags (FARMER/BUYER/TRANSPORT/ADMIN).
AUTH_PROVIDER="keycloak"

# Local Keycloak (docker-compose)
AUTH_KEYCLOAK_ID="otozboze-web"
AUTH_KEYCLOAK_SECRET="dev-otozboze-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/otozboze"

# AWS Cognito (production) — leave blank locally.
# Issuer format: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
AUTH_COGNITO_ID=""
AUTH_COGNITO_SECRET=""
AUTH_COGNITO_ISSUER=""

# --- Demo / prototype toggles ------------------------------------------------
# Enables the UI "Role Switcher" that swaps the active role without re-login.
# MUST stay false outside local development.
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER="true"

# Login-less demo mode: the session comes from a cookie and the account picker
# can become ANY seeded user. That is a complete bypass of authentication, so
# it is ON automatically in development and OFF in a production build.
#
# Setting this to "true" in production re-enables the bypass deliberately —
# only do that for a throwaway demo deployment, never for real data. With it
# off and no identity provider wired up yet, every page reports "Brak sesji".
# DEMO_MODE="true"
